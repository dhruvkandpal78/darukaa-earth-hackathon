# Copy to .env locally. VITE values are public and become part of the browser build.
DATABASE_URL=postgresql+psycopg://darukaa:darukaa@localhost:5432/darukaa
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ENVIRONMENT=development
VITE_MAPBOX_TOKEN=
# Leave empty for the same-origin Python API. Demo uses session memory, never real records.
VITE_API_URL=
